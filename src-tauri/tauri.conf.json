{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duet",
  "version": "0.1.0",
  "identifier": "app.duet.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "对奏 Duet",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0b0714"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http: https: data: blob:; media-src 'self' asset: http: https: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http: https: data: blob:; frame-src http: https:; worker-src 'self' blob:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "专注内容横向对比的本地优先应用",
    "longDescription": "对奏 Duet —— 同一套提示词，两个工具的产出并置对照：音乐、视频、图片、3D、音频、代码，皆可同台。数据全部保存在本机。",
    "copyright": "AGPL-3.0-or-later",
    "fileAssociations": [
      {
        "ext": ["duet"],
        "name": "Duet Project",
        "description": "对奏工程文件",
        "mimeType": "application/json",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "single-instance": {
      "enabled": true
    }
  }
}
