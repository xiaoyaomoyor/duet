{
  "name": "duet",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "对奏 Duet — 专注内容横向对比的本地优先 Web 应用。Same prompt. Two tools. One stage.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/xiaoyaomoyor/duet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoyaomoyor/duet.git"
  },
  "bugs": "https://github.com/xiaoyaomoyor/duet/issues",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && npm run check:contrast && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\"",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check": "npm run typecheck && npm run check:contrast && npm run lint && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "html-to-image": "latest",
    "pinia": "latest",
    "vue": "latest",
    "vue-draggable-plus": "0.6.1",
    "vue-i18n": "latest",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/sortablejs": "1.15.9",
    "@vitejs/plugin-vue": "latest",
    "@vitest/coverage-v8": "latest",
    "@vue/test-utils": "latest",
    "@vue/tsconfig": "latest",
    "eslint": "latest",
    "eslint-plugin-vue": "latest",
    "fake-indexeddb": "latest",
    "globals": "17.12.0",
    "jiti": "2.7.0",
    "jsdom": "latest",
    "prettier": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest",
    "vue-tsc": "latest"
  }
}
