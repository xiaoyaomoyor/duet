# —— 依赖与缓存 ——
node_modules/
.npm-cache/

# —— 构建产物 ——
dist/
dist-ssr/
coverage/
*.local

# —— 测试产物 ——
playwright-report/
test-results/
blob-report/
playwright/.cache/

# —— Tauri ——
src-tauri/target/
src-tauri/gen/

# —— 本地品牌 LOGO（第三方商标，刻意不入库） ——
# 由 scripts/fetch-brand-logos.mjs 生成。
# 提交他人商标等于再分发，风险远大于本机自用；
# 其他用户克隆时没有这个目录，界面会自动回退到生成的几何图标。
public/brand-local/

# —— 编辑器与系统 ——
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# —— 日志 ——
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# —— 开发时重定向的命令输出（避免误提交） ——
*.txt
!README*.txt
!FAQ*.txt

# —— 本地环境变量（示例文件 .env.example 需要提交） ——
.env
.env.*
!.env.example
